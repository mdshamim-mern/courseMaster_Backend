# Local backend configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/coursemaster
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_REGISTRATION_KEY=replace-with-a-separate-admin-registration-key
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email is optional. Leave these unset during local testing.
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASSWORD=
